# ============================================================================
#  TruthSource — environment configuration
#
#  Copy this file to `.env` and fill in your keys:
#      cp .env.example .env
#
#  Only GROQ_API_KEY is strictly required. Everything else degrades gracefully:
#  without Tavily, evidence retrieval falls back to DuckDuckGo and then
#  Wikipedia; without Firecrawl, URL scraping is disabled but text still works;
#  without PostgreSQL, fact-checking runs normally and only history is lost.
# ============================================================================

# ---- AI reasoning + vision + speech-to-text (REQUIRED) ---------------------
# Free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional model overrides. The defaults are sensible; change only if a model
# is retired or you want to experiment.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Evidence retrieval: PRIMARY (recommended) -----------------------------
# Free tier from https://tavily.com — purpose-built for RAG, best snippet quality.
# If this is missing or rate-limited, TruthSource automatically falls back to
# DuckDuckGo and then the Wikipedia API, both of which need no key.
TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_MAX_RESULTS=5
# TAVILY_TIMEOUT_MS=15000

# ---- Article scraping (optional) -------------------------------------------
# Free tier from https://firecrawl.dev — turns an article URL into clean markdown.
# Without it, the URL tab returns a clear "not configured" message.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ---- Database (optional) ---------------------------------------------------
# Either give a full connection string...
# DATABASE_URL=postgresql://postgres:password@localhost:5432/truthsource
# ...or the discrete parts:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=truthsource
# PGSSL=true          # enable for managed providers (Neon, Supabase, RDS)

# ---- Server ----------------------------------------------------------------
PORT=3000
# Comma-separated allowed origins. '*' (the default) suits local development and
# the browser extension; lock it down for a real deployment.
# CORS_ORIGINS=http://localhost:5173

# ---- Uploads ---------------------------------------------------------------
# MAX_IMAGE_BYTES=10485760      # 10 MB
# MAX_VIDEO_BYTES=209715200     # 200 MB
# VIDEO_CHUNK_SECONDS=120       # audio chunk length for streaming transcription

# ---- Telegram bot (optional) -----------------------------------------------
# Create a bot by messaging @BotFather on Telegram, then run `npm run bot`.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Where the bot should reach the TruthSource API.
# TRUTHSOURCE_API_URL=http://localhost:3000

# ---- Debugging -------------------------------------------------------------
# DEBUG=true
